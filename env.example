# Environment Variables for Privacy Mixer Deployment

# RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia.infura.io/v3/YOUR_INFURA_KEY
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private Key (for deployment)
PRIVATE_KEY=your_private_key_here

# API Keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
BASESCAN_API_KEY=your_basescan_api_key

# Frontend WalletConnect (for wallet connect modal)
# Create at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Gas Reporting
REPORT_GAS=true

# Contract Addresses (will be filled after deployment)
SEPOLIA_CONTRACT_ADDRESS=
MAINNET_CONTRACT_ADDRESS=
ARBITRUM_CONTRACT_ADDRESS=
ARBITRUM_SEPOLIA_CONTRACT_ADDRESS=
BASE_CONTRACT_ADDRESS=
BASE_SEPOLIA_CONTRACT_ADDRESS=
